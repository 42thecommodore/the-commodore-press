{
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run build)",
      "Bash(npm run stats)",
      "Bash(npm run voice)",
      "Bash(npm run new:*)",
      "Bash(npm run plate:*)",
      "Bash(npm run correct:*)",
      "Bash(npm run verify:*)",
      "Bash(node tools/validate.mjs)",
      "Bash(node tools/stats.mjs)",
      "Bash(node build/build.mjs)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Read(//Users/infamousalmanac/Downloads/The Commodore/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/id_rsa*)"
    ]
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-generated.sh",
            "statusMessage": "Checking house rules..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(content/**)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-content.sh",
            "statusMessage": "Validating the entry..."
          }
        ]
      }
    ]
  }
}
